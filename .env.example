# --- Slice 0: required for the app to boot and /api/health to pass ---

# Upstash Redis (guest session TTL store, job progress cache, rate limits)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash (async job transport for boilerplate generation)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Cloudflare R2 (S3-compatible object storage for generated file trees/zips)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Groq (PRD/stack generation, idea generator, moderation gate)
GROQ_API_KEY=

# Slice 4: base URL this app is reachable at, used as the QStash callback target.
# Local dev: http://localhost:3000 (QStash can't reach this — see lib/pipeline/boilerplateWorker.ts
# notes on local testing). Production: the real deployed URL.
APP_URL=http://localhost:3000

# Slice 7: Neon Postgres (schema in lib/db/schema.ts) + Auth.js GitHub sign-in
# (read:user user:email scope by default; a user can separately re-authorize with the
# additional "repo" scope from /account to enable GitHub auto-push — same OAuth App, no
# separate app needed, see lib/auth.ts's jwt callback and lib/github/).
# AUTH_SECRET: generate with `npx auth secret` or `openssl rand -base64 32`.
DATABASE_URL=
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Slice 11: encrypts the elevated GitHub access token (lib/github/tokenCrypto.ts) before storing
# it in githubConnections — a leaked DB dump shouldn't hand out live repo-write credentials.
# Generate with `openssl rand -base64 32`.
GITHUB_TOKEN_ENCRYPTION_KEY=

# --- Introduced in later slices, not required yet ---

# Slice 4 (production): a real isolated sandbox, replacing the interim local-subprocess
# validator in lib/sandbox/validate.ts, e.g. Vercel Sandbox:
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
# VERCEL_TOKEN=

# Slice 13: Resend (email notifications)
# RESEND_API_KEY=
