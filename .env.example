# --- Slice 0: required for the app to boot and /api/health to pass ---

# Upstash Redis (guest session TTL store, job progress cache, rate limits)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash QStash (async job transport for boilerplate generation)
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Cloudflare R2 (S3-compatible object storage for generated file trees/zips)
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Groq (PRD/stack generation, idea generator, moderation gate)
GROQ_API_KEY=

# Slice 4: base URL this app is reachable at, used as the QStash callback target.
# Local dev: http://localhost:3000 (QStash can't reach this — see lib/pipeline/boilerplateWorker.ts
# notes on local testing). Production: the real deployed URL.
APP_URL=http://localhost:3000

# --- Introduced in later slices, not required yet ---

# Slice 4 (production): a real isolated sandbox, replacing the interim local-subprocess
# validator in lib/sandbox/validate.ts, e.g. Vercel Sandbox:
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
# VERCEL_TOKEN=

# Slice 7: Neon Postgres + Auth.js
# DATABASE_URL=
# AUTH_SECRET=
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Slice 11: GitHub App (repo push, separate from sign-in above)
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=

# Slice 13: Resend (email notifications)
# RESEND_API_KEY=
